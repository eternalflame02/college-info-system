# ==================================================
# College Info System - Environment Configuration
# ==================================================
# Copy this file to .env and customize values for your local setup.
# Example:
#   cp .env.example .env

# ==================================================
# Scraping Configuration
# ==================================================

# Base URL for institutional crawling
BASE_URL=https://mbcet.ac.in

# Seed URL for the CSE department
CSE_DEPARTMENT_URL=https://mbcet.ac.in/departments/computer-science-engineering/

# Delay between requests (seconds)
REQUEST_DELAY=1.0

# Retry attempts for failed HTTP requests
MAX_RETRIES=3

# ==================================================
# Chunking Configuration
# ==================================================

# Minimum words per chunk
MIN_CHUNK_WORDS=80

# Maximum words per chunk
MAX_CHUNK_WORDS=700

# Preferred target chunk size
PREFERRED_CHUNK_WORDS=450

# Soft split limit before hard max
SOFT_LIMIT_WORDS=600

# ==================================================
# OCR Configuration (Optional)
# ==================================================

# Path to Tesseract executable.
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/macOS example: tesseract
TESSERACT_CMD=tesseract

# ==================================================
# Embedding Configuration
# ==================================================

# Embedding model used by sentence-transformers
EMBEDDING_MODEL=google/embeddinggemma-300m

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=64

# Enable query/document prompt-style embedding methods if supported
EMBEDDING_USE_QUERY_DOC_METHODS=1

# Prompt names for embedding model APIs
EMBEDDING_DOCUMENT_PROMPT_NAME=Retrieval-document
EMBEDDING_QUERY_PROMPT_NAME=Retrieval-query

# Optional Hugging Face token for gated/rate-limited models
HF_TOKEN=

# ==================================================
# LLM Configuration (Groq)
# ==================================================

# API key used for answer synthesis
GROQ_API_KEY=

# Default synthesis model
GROQ_MODEL=llama-3.3-70b-versatile

# ==================================================
# ChromaDB Retrieval Configuration
# ==================================================

# Enable routed multi-collection retrieval behavior
CHROMADB_MULTI_COLLECTION_ENABLED=1

# Allow fallback to legacy collection if route quality is poor/sparse
CHROMADB_ENABLE_LEGACY_FALLBACK=1

# Collection names for routed storage
CHROMADB_TABLE_COLLECTION=mbcet_cse_table
CHROMADB_NON_TABLE_COLLECTION=mbcet_cse_non_table

# ==================================================
# FastAPI Runtime Configuration
# ==================================================

# Warm heavy chatbot resources during API startup.
# Set to 0 for faster startup during frontend/API development.
CHAT_WARMUP_ON_STARTUP=1

# Comma-separated CORS allowlist.
# Keep localhost defaults for local development.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Public URL used when exposing the app (for CORS/default origin wiring)
PUBLIC_BASE_URL=https://hyo-gymnocarpous-lingeringly.ngrok-free.dev

# Reserved ngrok domain (without protocol)
NGROK_DOMAIN=hyo-gymnocarpous-lingeringly.ngrok-free.dev

# Start ngrok automatically when running: python main.py --stage serve
AUTO_START_NGROK=0

# Note:
# On ngrok free plan, the anti-abuse interstitial can appear on first browser visit.
# API/XHR calls can bypass it by sending header: ngrok-skip-browser-warning: 1
